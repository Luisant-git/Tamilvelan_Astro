# Origin only (no trailing slash or /api suffix) of the backend API server.
# Local dev: http://localhost:3000   Production: http://<backend-host>:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

NEXT_PUBLIC_RAZORPAY_KEY_ID="your-razorpay-key-id"

# App
# PORT/HOSTNAME: only needed for `npm start` (production-style local hosting,
# e.g. via pm2). Vercel ignores both — it never runs this script. `npm run
# dev` ignores both too (uses its own -p 3001 flag).
NODE_ENV="development"
PORT=3001
HOSTNAME="0.0.0.0"
