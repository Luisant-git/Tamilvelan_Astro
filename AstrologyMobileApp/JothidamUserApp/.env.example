# Copy to .env and set the right value for how you're running the app.
# EXPO_PUBLIC_* vars are inlined at bundle time — after changing this file,
# restart Metro with cache cleared: `npx expo start -c`.
#
# Backend dev server: cd backend/ && npm run dev   (runs on port 3000)
#
# Pick ONE based on how you're testing:
#   - Expo web (browser, same machine as the backend):
#       EXPO_PUBLIC_API_URL=http://localhost:3000/api
#   - Android emulator (10.0.2.2 is the emulator's alias for the host machine):
#       EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api
#   - iOS Simulator (shares the host's network stack, localhost works directly):
#       EXPO_PUBLIC_API_URL=http://localhost:3000/api
#   - Expo Go on a physical phone (same Wi-Fi as the dev machine — use the
#     dev machine's actual LAN IP, found via `ipconfig` on Windows /
#     `ifconfig`/`ip addr` on Mac/Linux; this changes if you switch networks):
#       EXPO_PUBLIC_API_URL=http://YOUR_LAN_IP:3000/api

EXPO_PUBLIC_API_URL=http://localhost:3000/api
