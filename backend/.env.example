# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/jothidam_db"

# Auth
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Optional — overrides the seed script's default admin password ("admin123").
# Set this before running `npm run db:seed` against a real deployment so a
# known password never ends up as the actual admin credential.
ADMIN_SEED_PASSWORD="choose-a-strong-password-for-real-deployments"

# Astrology APIs
VEDASTRO_API_URL="https://vedastro.org/api"
PROKERALA_API_KEY="your-prokerala-api-key"

# Google Geocoding (server-side)
GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# Razorpay (server-side keys only)
RAZORPAY_KEY_ID="your-razorpay-key-id"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"

# Twilio SMS
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"

# AWS S3
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret"
AWS_BUCKET_NAME="jothidam-reports"
AWS_REGION="ap-south-1"

# CORS — comma-separated list of additional allowed origins for the
# frontend, if it's ever hosted somewhere other than localhost/a LAN IP
# (those are already auto-allowed, see middleware.ts's DEV_ORIGIN_RE).
CORS_ALLOWED_ORIGINS="https://your-frontend-domain.com"

# App
# PORT/HOSTNAME: only needed for `npm start` (production-style local hosting,
# e.g. via pm2) or a platform that doesn't inject its own $PORT. Render sets
# $PORT itself — leave these unset there. `npm run dev` ignores both.
NODE_ENV="development"
PORT=3000
HOSTNAME="0.0.0.0"
